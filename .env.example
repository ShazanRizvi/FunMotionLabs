# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=funmotionlabs
POSTGRES_PORT=5432

# Database URL (used by Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 
# IMPORTANT: Choose the correct URL based on your environment:
# 
# For Docker (when running docker-compose):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/funmotionlabs
#
# For Local Development (when running outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/funmotionlabs
#
# Default below is for Docker. Change 'postgres' to 'localhost' for local development.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/funmotionlabs

# Frontend Configuration
VITE_API_URL=http://localhost:3001
